# Copy to .env and adjust. Never commit the real .env file.

# Database. Leave DATABASE_URL unset to use the in-memory stores (quick tries and the unit tests).
# With a database, use the pooled URL here and the direct (unpooled) URL for migrations.
# DATABASE_URL=postgresql+psycopg://user:password@host/db
# DATABASE_URL_UNPOOLED=postgresql+psycopg://user:password@host/db

# Application secret. It keys the idempotency fingerprints; session tokens are random
# and opaque and do not use it. Use a long random value outside local development:
# the API refuses to start with the placeholder unless TEST_MODE=1.
SESSION_SECRET=change-me

# Test-only controls. The local start script sets this to 1 for local development.
# Keep 0 in every public deployment (see docs/ARCHITECTURE.md for the guard table).
TEST_MODE=0
# When TEST_MODE=0, the controls answer only to requests with this X-Test-Token. Leave empty to disable them.
TEST_TOKEN=

# Default tax rate in percent. A reset restores it; the seed totals assume 10.
DEFAULT_TAX_RATE=10

# Origin of the web app. The session cookie is Secure when it starts with https://.
# (The CSRF origin check that will also use it is a later task.)
APP_ORIGIN=http://localhost:3000

# Number of reverse proxies in front of the API. The client IP is taken from
# X-Forwarded-For counting that many entries from the right. 0 means none.
TRUSTED_PROXY_COUNT=0

# Longest wait for a row lock, in milliseconds (100 to 60000). Beyond it the request gets 503 LOCK_TIMEOUT.
LOCK_TIMEOUT_MS=5000

