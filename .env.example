# Copy to .env and adjust. Never commit the real .env file.

# Database
DATABASE_URL=postgresql+psycopg://labapp:labapp@localhost:5432/labapp

# Session cookie signing key (use a long random value outside local development)
SESSION_SECRET=change-me

# Test-only controls: 1 enables /__test__ routes. Keep 0 for any public deployment.
TEST_MODE=0
# When TEST_MODE=0, the controls answer only to requests with this X-Test-Token. Leave empty to disable them.
TEST_TOKEN=

# Default tax rate in percent, used by the seed data
DEFAULT_TAX_RATE=10

# Frontend: where the web app proxies /api
API_URL=http://localhost:8000
